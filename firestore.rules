rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // กฎสำหรับ Collection 'users'
    match /users/{userId} {
      allow read: if true; // สำหรับ Leaderboard
      allow write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    // Student Scores (from the main site)
    match /student_scores/{studentId} {
      allow read: if true; // Anyone can read a score if they know the exact ID
      allow write: if request.auth != null && request.auth.token.email == "taweerak.t@promma.ac.th"; // Only teacher can upload
    }

    // Leaderboard
    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // --- Challenge / Lobby System ---
    match /lobbies/{lobbyId} {
      // อนุญาตให้ใครก็ได้ที่ล็อกอินอ่านห้องได้
      allow read: if request.auth != null;
      
      // อนุญาตให้สร้างห้อง หรืออัปเดตห้อง (เช่น เริ่มเกม, อัปเดตคะแนน)
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      
      // ลบห้อง: เฉพาะ Host (เช็คจาก field hostId) หรือใครก็ได้ (เพื่อความง่ายในการ Cleanup ถ้าจำเป็น)
      // แต่เพื่อความปลอดภัย ให้เฉพาะ Host ดีกว่า
      allow delete: if request.auth != null && (resource.data.hostId == request.auth.uid || resource.data.hostId == null);

      // Subcollection: messages (Chat)
      match /messages/{messageId} {
        allow read, create: if request.auth != null;
      }

      // Subcollection: presence (Heartbeat) - MISSING IN PREVIOUS RULES
      match /presence/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      // Subcollection: typing (Typing Indicator) - MISSING IN PREVIOUS RULES
      match /typing/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
