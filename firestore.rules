rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // กฎสำหรับ Collection 'users'
    match /users/{userId} {
      allow read: if true; // สำหรับ Leaderboard
      
      // =========================================================================
      // 🚨 จุดที่ 1: สิทธิ์การเขียนข้อมูลโปรไฟล์และ XP (Collection 'users')
      // =========================================================================
      // ปัจจุบัน: เปิดให้หน้าเว็บเซฟคะแนนตัวเองได้ (เผื่อกรณีคุณยังไม่ได้ใช้ Cloud Functions 100%)
      allow write: if request.auth != null && request.auth.uid == userId; 
      
      // 🛡️ อนาคต (เมื่อคุณย้ายการคำนวณ XP ไปบน Cloud Functions หมดแล้ว):
      // ให้ลบบรรทัด "ปัจจุบัน" ข้างบนทิ้ง แล้วเอาเครื่องหมาย // ออกจากบรรทัดข้างล่างนี้แทน
      // allow write: if false;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }


    // Leaderboard
    match /leaderboard/{userId} {
      allow read: if true;
      
      // =========================================================================
      // 🚨 จุดที่ 2: สิทธิ์การเขียนกระดานจัดอันดับ (Collection 'leaderboard')
      // =========================================================================
      // ปัจจุบัน: เปิดให้หน้าเว็บอัปเดตคะแนนตัวเองลงกระดานได้
      allow write: if request.auth != null && request.auth.uid == userId; 
      
      // 🛡️ อนาคต (เมื่อคุณใช้ Cloud Functions อัปเดต Leaderboard แล้ว):
      // ให้ลบบรรทัด "ปัจจุบัน" ข้างบนทิ้ง แล้วเอาเครื่องหมาย // ออกจากบรรทัดข้างล่างนี้แทน
      // allow write: if false;
    }

    // --- Challenge / Lobby System ---
    match /lobbies/{lobbyId} {
      // อนุญาตให้ใครก็ได้ที่ล็อกอินอ่านห้องได้
      allow read: if request.auth != null;
      
      // อนุญาตให้สร้างห้อง หรืออัปเดตห้อง (เช่น เริ่มเกม, อัปเดตคะแนน)
      allow create: if request.auth != null;
      
      // ในอุดมคติควรเขียนให้รัดกุมกว่านี้ แต่เบื้องต้นอนุญาตให้อัปเดตได้เพื่อไม่ให้ระบบ Join/Ready พัง
      allow update: if request.auth != null; 
      
      // ลบห้อง: เฉพาะ Host (เช็คจาก field hostId) หรือใครก็ได้ (เพื่อความง่ายในการ Cleanup ถ้าจำเป็น)
      allow delete: if request.auth != null && (resource.data.hostId == request.auth.uid || resource.data.hostId == null);

      // Subcollection: messages (Chat)
      match /messages/{messageId} {
        allow read, create: if request.auth != null;
      }

      // Subcollection: presence (Heartbeat) - MISSING IN PREVIOUS RULES
      match /presence/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      // Subcollection: typing (Typing Indicator) - MISSING IN PREVIOUS RULES
      match /typing/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Student Scores — read-only (นักเรียนค้นหาด้วยรหัส 5 หลัก)
    match /student_scores/{studentId} {
      allow read: if true;
      allow write: if true;
    }

    // Pre-computed summary statistics — read-only (หน้าสรุปสถิติ)
    match /scores_summaries/{semesterId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
