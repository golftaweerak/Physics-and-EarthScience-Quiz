{
  "name": "physics-earth-science-quiz",
  "version": "1.0.0",
  "description": "A quiz and score tracking application for Physics and Earth Science.",
  "type": "module",
  "scripts": {
    "update:term1": "node tools/convert-scores.js",
    "update:term2": "node tools/fetch-term2.js",
    "update:list": "node tools/update-quiz-list.js",
    "validate:duplicates": "node tools/check-duplicates.js",
    "validate:subcategories": "node tools/validate-subcategories.js",
    "summarize": "node tools/summarize-categories.js",
    "validate": "npm run validate:duplicates && npm run validate:subcategories",
    "manage": "npm run update:list && npm run validate",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "firebase": "^12.8.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "chalk": "^5.6.2"
  }
}
