{
  "name": "physics-earth-science-quiz",
  "version": "1.0.0",
  "description": "A quiz and score tracking application for Physics and Earth Science.",
  "type": "module",
  "scripts": {
    "update:term1": "node tools/convert-scores.js",
    "update:term2": "node tools/fetch-term2.js",
    "update:list": "node tools/update-quiz-list.js",
    "validate:duplicates": "node tools/check-duplicates.js",
    "validate:subcategories": "node tools/validate-subcategories.js",
    "summarize": "node tools/summarize-categories.js",
    "validate": "npm run validate:duplicates && npm run validate:subcategories",
    "manage": "npm run update:list && npm run validate",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "clear-cache": "rimraf node_modules/.cache/gh-pages",
    "deploy": "npm run build && gh-pages -d dist",
    "ship": "(node tools/upload-scores-firestore.js || echo \"⚠️ Firestore upload failed. Continuing deployment...\") && git add . && (git commit -m \"Update and deploy\" || echo \"Nothing to commit\") && git push && npm run deploy"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "firebase": "^12.8.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.3",
    "@vitest/coverage-v8": "^4.0.18",
    "chalk": "^5.6.2",
    "gh-pages": "^6.3.0",
    "jsdom": "^27.4.0",
    "mathjs": "^15.1.0",
    "rimraf": "^6.1.2",
    "tailwindcss": "^4.0.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
